{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": false
  },
  "include": ["*.ts", "llamatools/bash.ts", "llamatools/cli.ts", "llamatools/config.ts", "llamatools/fs.ts", "llamatools/http.ts", "llamatools/llamaharness.ts", "llamatools/notes.ts"]
}
