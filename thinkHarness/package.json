{
  "name": "thinkharness",
  "version": "0.1.0",
  "description": "Chatbot TUI that drives a llama.cpp (OpenAI-compatible) backend with MCP tools from llamaharness",
  "type": "module",
  "private": true,
  "main": "dist/harness.js",
  "bin": {
    "thinkharness": "dist/harness.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
